                "schema": {
                  "$ref": "#/components/schemas/ConsentStatusResponse"
                }
              }
            }
          },
          "400": {
            "description": "Unknown outcome / not a redirect ceremony"
          },
          "404": {
            "description": "Unknown authorisation"
          },
          "409": {
            "description": "Illegal state transition"
          }
        },
        "security": []
      }
    },
    "/v1/consents/{id}/authorisations/{authorisationId}/decoupled": {
