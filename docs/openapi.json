          "sca"
        ],
        "summary": "`POST /v1/consents/{id}/authorisations/{authId}/decoupled` - push the\nSCA request to the PSU's device/app (out-of-band) + return the poll\ndocument.",
        "operationId": "start_decoupled",
        "responses": {
          "200": {
            "description": "Decoupled ceremony started",
            "content": {
