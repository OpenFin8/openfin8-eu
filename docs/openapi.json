{
  "openapi": "3.1.0",
  "info": {
    "title": "openfin8-eu",
    "description": "Sentin8 OpenFin8:EU - European open finance (Berlin Group openFinance V2: AIS/PIS/PIIS over XS2A, the three SCA approaches, eIDAS QWAC/QSEALC certificates, signing baskets). The openFinance OpenAPI files are published under Creative Commons Attribution 4.0 (CC BY 4.0); resource paths carried with the attribution preserved. The normative reference remains the Implementation Guidelines.",
    "license": {
      "name": "MIT OR Apache-2.0",
      "identifier": "MIT OR Apache-2.0"
    },
    "version": "0.1.0"
  },
  "paths": {
    "/v1/ais/consents/{consentId}/accounts": {
      "get": {
        "tags": [
          "ais"
        ],
        "summary": "`GET /v1/ais/consents/{id}/accounts` - the accounts list behind an\nAIS consent (the chokepoint + the Ledger proxy).",
        "operationId": "get_accounts",
        "responses": {
          "200": {
            "description": "Accounts list",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AccountsPassthrough"
                }
              }
            }
          },
          "403": {
            "description": "The consent chokepoint rejected the read"
          },
          "404": {
            "description": "Unknown consent"
          },
          "503": {
            "description": "Ledger proxy transport absent"
          }
        },
        "security": []
      }
    },
    "/v1/ais/consents/{consentId}/accounts/{accountId}/balances": {
      "get": {
        "tags": [
          "ais"
        ],
        "summary": "`GET /v1/ais/consents/{id}/accounts/{accountId}/balances` - the\nbalances read behind an AIS consent.",
        "operationId": "get_balances",
        "responses": {
          "200": {
            "description": "Balances",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AccountsPassthrough"
                }
              }
            }
          },
          "403": {
            "description": "The consent chokepoint rejected the read"
          },
          "503": {
            "description": "Ledger proxy transport absent"
          }
        },
        "security": []
      }
    },
    "/v1/ais/consents/{consentId}/accounts/{accountId}/transactions": {
      "get": {
        "tags": [
          "ais"
        ],
        "summary": "`GET /v1/ais/consents/{id}/accounts/{accountId}/transactions` - the\ntransactions read behind an AIS consent (the lookback window the\nconsent pins is applied ledger-side; the chokepoint enforced it).",
        "operationId": "get_transactions",
        "responses": {
          "200": {
            "description": "Transactions",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AccountsPassthrough"
                }
              }
            }
          },
          "403": {
            "description": "The consent chokepoint rejected the read"
          },
          "503": {
            "description": "Ledger proxy transport absent"
          }
        },
        "security": []
      }
    },
    "/v1/ais/consents/{consentId}/card-accounts": {
      "get": {
        "tags": [
          "ais"
        ],
        "summary": "`GET /v1/ais/consents/{id}/card-accounts` - the card-accounts read\nbehind an AIS consent (out-of-scope data families return the XS2A\nunsupported response, never stubbed data - the honest answer until\nthe card-account resource ships).",
        "operationId": "get_card_accounts",
        "responses": {
          "403": {
            "description": "The consent chokepoint rejected the read"
          },
          "501": {
            "description": "The card-account resource is not served by this deployment"
          }
        },
        "security": []
      }
    },
    "/v1/consents": {
      "post": {
        "tags": [
          "consent"
        ],
        "summary": "`POST /v1/consents` - create an XS2A consent (the `received` state;\nthe PSU ceremony has not begun).",
        "operationId": "create_consent",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateConsentRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "Consent created (status received)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ConsentResponse"
                }
              }
            }
          },
          "400": {
            "description": "Invalid service/scopes"
          },
          "401": {
            "description": "Not authenticated"
          }
        },
        "security": []
      }
    },
    "/v1/consents/{id}": {
