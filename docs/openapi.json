    "/v1/consents/{id}/authorisations/{authorisationId}/callback": {
      "post": {
        "tags": [
          "sca"
        ],
        "summary": "`POST /v1/consents/{id}/authorisations/{authorisationId}/callback` -\nthe redirect-SCA callback: the PSU returned from the ASPSP's SCA page\nwith the ceremony outcome.",
        "operationId": "redirect_callback",
        "requestBody": {
          "content": {
            "application/json": {
