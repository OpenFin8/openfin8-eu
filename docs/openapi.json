        "tags": [
          "payments"
        ],
        "summary": "`POST /v1/payments/{paymentProduct}` - payment initiation: verify the\nQSEALC signature (EU invariant 1, fail-closed), then proxy to\nBank8:Payments through the public API (the OBVERT boundary).",
        "operationId": "create_payment",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreatePaymentRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "Payment initiated",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PaymentResponse"
                }
              }
            }
          },
          "400": {
            "description": "Unknown payment product"
          },
          "401": {
            "description": "Not authenticated"
          },
          "403": {
            "description": "QSEALC verification failed (fail-closed)"
