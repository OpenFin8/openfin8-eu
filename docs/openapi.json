  "components": {
    "schemas": {
      "AccountsPassthrough": {
        "description": "The AIS accounts list (the forwarded Ledger document, CSDF-minimized\nby the ledger-side scope projection; genuinely freeform envelope)."
      },
      "AuthorisationListResponse": {
        "type": "object",
        "description": "`GET /v1/consents/{id}/authorisations` - list the consent's\nauthorisation sub-resources (the TPP polls these under decoupled SCA).",
        "required": [
          "authorisations"
        ],
        "properties": {
          "authorisations": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/AuthorisationResponse"
            },
            "description": "The consent's authorisation sub-resources."
          }
        }
      },
      "AuthorisationResponse": {
        "type": "object",
        "description": "An authorisation sub-resource document (wire shape).",
        "required": [
          "authorisationId",
          "consentId",
          "status",
          "approach",
          "createdAt"
        ],
        "properties": {
          "approach": {
            "type": "string",
            "description": "The SCA approach this ceremony runs."
          },
          "authorisationId": {
            "type": "string",
            "format": "uuid",
            "description": "The authorisation id."
          },
          "consentId": {
            "type": "string",
            "format": "uuid",
            "description": "The parent consent id."
          },
          "createdAt": {
            "type": "string",
            "format": "date-time",
            "description": "Creation timestamp."
          },
          "expiresAt": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time",
            "description": "The ceremony's expiry."
          },
          "flowExecutionId": {
            "type": [
              "string",
              "null"
            ],
            "format": "uuid",
            "description": "The Flow execution driving the ceremony (absent until started)."
          },
          "psuId": {
            "type": [
              "string",
              "null"
            ],
            "description": "The PSU identity once identified."
          },
          "status": {
            "type": "string",
            "description": "The per-approach authorisation status."
          }
        }
      },
      "BasketResponse": {
        "type": "object",
        "description": "The signing-basket document.",
        "required": [
          "basketId",
          "status",
          "consentIds",
          "paymentIds",
          "createdAt"
        ],
        "properties": {
          "basketId": {
            "type": "string",
            "format": "uuid",
